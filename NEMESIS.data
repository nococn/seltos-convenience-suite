[nemesis]
version=1.1
id=seltos.convenience
name=셀토스 편의 기능 패키지 (Seltos Suite)
type=service,application
package-version=1.8.1
short-desc="셀토스 SP2PE 실차 프레임워크 해시 동기화, 안전 plan 검증 및 TBT 연동"
detailed-desc="v1.8.1: 실차 진단 데이터 5대 핵심 사항 전량 반영. tee/head/cut 제거 및 autolaunch 12초 무한 반복 루프 완치, 실차 맵 동적 생성(map-car --write) 및 verify-map 보장, 안전 plan 검증 및 원터치 apply 지원."
os="SP2PE.KOR.*"
models="*_kr"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
name=10밴드 DSP EQ 음향 토글 (A/B 청음)
path=bin/audio_toggle.sh
uid=root

[app.1]
kind=sh
name=셀토스 실차 진단 데이터 수집 (USB 저장)
path=bin/diag.sh
uid=root

[app.2]
kind=sh
name=TBT 모드 시스템 적용 (apply)
path=bin/apply_tbt.sh
uid=root

[app.3]
kind=sh
name=로그 기록 켜기/끄기 (끄면 기록 삭제)
path=bin/logger_toggle.sh
uid=root

[service.0]
name=cp-autolaunch
kind=sh
path=svc/autolaunch.sh
uid=root
mode=restart

[service.1]
name=seltos-logger
kind=sh
path=svc/logger.sh
uid=root
mode=restart
