[nemesis]
version=1.1
id=seltos.convenience
name=셀토스 편의 기능 패키지 (Seltos Suite)
type=service,application
package-version=1.0.0
short-desc="셀토스 SP2PE 실차 동적 맵 생성 및 TBT/DSP 편의 패키지 (v1.0.0)"
detailed-desc="v1.0.0: 실차 진단 실측 피드백 정석 반영. 차내 map-car --write 동적 생성 및 검증(342/342 훅 통과), hmgapid engine install <zip> 단일 규격 수정, autolaunch 정상 이벤트 트리거 및 디바운스, 킷캣 logger 폴백 탑재."
os="SP2PE.KOR.*"
models="*_kr"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
name=10밴드 DSP EQ 음향 토글 (A/B 청음)
path=bin/audio_toggle.sh
uid=root

[app.1]
kind=sh
name=셀토스 실차 진단 데이터 수집 (USB 저장)
path=bin/diag.sh
uid=root

[app.2]
kind=sh
name=로그 기록 켜기/끄기 (끄면 기록 삭제)
path=bin/logger_toggle.sh
uid=root

[service.0]
name=cp-autolaunch
kind=sh
path=svc/autolaunch.sh
uid=root
mode=restart

[service.1]
name=seltos-logger
kind=sh
path=svc/logger.sh
uid=root
mode=restart
