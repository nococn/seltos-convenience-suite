[nemesis]
version=1.3
id=seltos.convenience
name=셀토스 편의 기능 패키지 (Seltos Suite)
type=service,application
package-version=1.3.1
short-desc="카플레이 TBT 계기판 연동, 6스피커 맞춤 ALSA DSP, HUD 텔레메트리"
detailed-desc="기아 더 뉴 셀토스 SP2PE 전용 통합 편의 패키지:
1. 유선/동글 카플레이 턴바이턴 계기판 연동 (T-Map/네이버지도)
2. 시동 후 카플레이 자동 전체화면 전환 (후방카메라 간섭 방지)
3. 순정 오디오 AAC 고음질 무손실 코덱 패치
4. 셀토스 기본 6스피커 맞춤형 ALSA DSP 10밴드 EQ 및 -4.0dB 클리핑 프리앰프
5. HUD 스타일 미니 텔레메트리 오버레이 (배터리 전압, 냉각수/오일 온도, TPMS)
6. 핸들 즐겨찾기(★) 버튼 연동 HUD 원터치 토글"
os="SP2PE.KOR.*"
models="*_kr"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
name=오디오 고음질 ON (AAC + 10밴드 EQ)
path=bin/audio_on.sh
uid=root

[app.1]
kind=sh
name=오디오 순정 모드 OFF (A/B 플랫 비교)
path=bin/audio_off.sh
uid=root

[app.2]
kind=sh
name=HUD 미니 텔레메트리 토글 (핸들 ★ 연동)
path=bin/hud_toggle.sh
uid=root

[service.0]
name=cp-autolaunch
kind=sh
path=svc/autolaunch.sh
uid=root
mode=restart

[service.1]
name=seltos-hud-telemetry
kind=sh
path=svc/hud_telemetry.sh
uid=root
mode=restart
