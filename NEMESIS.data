[nemesis]
version=1.1
id=seltos.convenience
name=셀토스 편의 기능 패키지 (Seltos Suite)
type=service,application
package-version=1.1.0
short-desc="유선/동글 카플레이 계기판 연동, 자동 화면 전환, AAC 고음질 A/B 비교"
detailed-desc="기아 더 뉴 셀토스 SP2PE 전용 편의 패키지:
1. 유선/동글 카플레이 턴바이턴 계기판 연동 (T-Map/네이버지도)
2. 시동 후 카플레이 자동 전체화면 전환 (후방카메라 간섭 방지)
3. 순정 오디오 AAC 고음질 무손실 패치
4. 오디오 고음질 ON / 순정 원복 OFF 원터치 A/B 비교 스위치"
os="SP2PE.KOR.*"
models="*_kr"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
name=오디오 고음질 ON (AAC 패치)
path=bin/audio_on.sh
uid=root

[app.1]
kind=sh
name=오디오 순정 모드 OFF (A/B 비교)
path=bin/audio_off.sh
uid=root

[service.0]
name=cp-autolaunch
kind=sh
path=svc/autolaunch.sh
uid=root
mode=restart
