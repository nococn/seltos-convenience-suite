[nemesis]
version=1.1
id=seltos.convenience
name=셀토스 음향 DSP 튜닝 패키지 (Seltos Audio Suite)
type=service,application
package-version=1.4.0
short-desc="셀토스 기본 6스피커 맞춤 ALSA DSP 10밴드 파라메트릭 EQ"
detailed-desc="기아 더 뉴 셀토스 SP2PE Gen5W 전용: 기본 6스피커 맞춤 ALSA 하드웨어 DSP 10밴드 파라메트릭 EQ, -5.0dBFS 마스터 프리앰프 게인 스태킹 클리핑 방어, 원터치 A/B 청음 토글 지원."
os="SP2PE.KOR.*"
models="*_kr"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
name=10밴드 DSP EQ 음향 토글 (A/B 청음)
path=bin/audio_toggle.sh
uid=root

[service.0]
name=cp-autolaunch
kind=sh
path=svc/autolaunch.sh
uid=root
mode=restart
