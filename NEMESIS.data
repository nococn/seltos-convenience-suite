[nemesis]
version=1.1
id=seltos.convenience
name=셀토스 편의 기능 패키지 (Seltos Suite)
type=service,application
package-version=1.7.6
short-desc="셀토스 SP2PE 실차 동적 맵 생성 및 안전 Plan 검증 패키지"
detailed-desc="v1.7.6: 실차 진단 피드백 3대 원칙 100% 정석 구현. 패키지 지도 전면 제외 후 차내에서 map-car --write 동적 생성, --any-car 모드 plan 결과 안전 수집, autolaunch 12초 루프 완치 및 logger/diag 수집 보강."
os="SP2PE.KOR.*"
models="*_kr"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
name=10밴드 DSP EQ 음향 토글 (A/B 청음)
path=bin/audio_toggle.sh
uid=root

[app.1]
kind=sh
name=셀토스 실차 진단 데이터 수집 (USB 저장)
path=bin/diag.sh
uid=root

[app.2]
kind=sh
name=로그 기록 켜기/끄기 (끄면 기록 삭제)
path=bin/logger_toggle.sh
uid=root

[service.0]
name=cp-autolaunch
kind=sh
path=svc/autolaunch.sh
uid=root
mode=restart

[service.1]
name=seltos-logger
kind=sh
path=svc/logger.sh
uid=root
mode=restart
