[nemesis]
version=1.1
id=seltos.convenience
name=셀토스 편의 기능 패키지 (Seltos Suite)
type=service,application
package-version=1.8.0
short-desc="셀토스 SP2PE 실차 프레임워크 해시 정밀 동기화 & 클러스터 TBT 연동"
detailed-desc="v1.8.0: 실차 진단 덤프 기반 18개 odex 해시 100% 동기화 (verify-map 통과), RFC 9562 v8 키 일치 서명 바이너리 실장, 클러스터 TBT 훅 활성화 및 10밴드 EQ -5.0dBFS 마스터 프리앰프 완비."
os="SP2PE.KOR.*"
models="*_kr"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
name=10밴드 DSP EQ 음향 토글 (A/B 청음)
path=bin/audio_toggle.sh
uid=root

[app.1]
kind=sh
name=셀토스 실차 진단 데이터 수집 (USB 저장)
path=bin/diag.sh
uid=root

[app.2]
kind=sh
name=로그 기록 켜기/끄기 (끄면 기록 삭제)
path=bin/logger_toggle.sh
uid=root

[service.0]
name=cp-autolaunch
kind=sh
path=svc/autolaunch.sh
uid=root
mode=restart

[service.1]
name=seltos-logger
kind=sh
path=svc/logger.sh
uid=root
mode=restart
