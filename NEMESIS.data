[nemesis]
version=1.1
id=seltos.convenience
name=셀토스 편의 기능 패키지 (Seltos Suite)
type=service,application
package-version=1.7.3
short-desc="셀토스 SP2PE TBT 시험(HMG-API, 미검증 지도) & 진단기 (EQ는 믹서 불가)"
detailed-desc="v1.7.3: 유선 시험용 내부 로그 기록 서비스 추가(최대 약 4MB 순환). 단계별 성공/실패를 그대로 표시, 지도 검증 실패 시 패치 중단, 진단기가 head/tail 없는 4.4.2에서 동작. 셀토스 훅 지도는 차에서 검증되지 않음. 10밴드 EQ는 tinymix가 없어 적용되지 않음."
os="SP2PE.KOR.*"
models="*_kr"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
name=10밴드 DSP EQ 음향 토글 (A/B 청음)
path=bin/audio_toggle.sh
uid=root

[app.1]
kind=sh
name=셀토스 실차 진단 데이터 수집 (USB 저장)
path=bin/diag.sh
uid=root

[app.2]
kind=sh
name=로그 기록 켜기/끄기 (끄면 기록 삭제)
path=bin/logger_toggle.sh
uid=root

[service.0]
name=cp-autolaunch
kind=sh
path=svc/autolaunch.sh
uid=root
mode=restart

[service.1]
name=seltos-logger
kind=sh
path=svc/logger.sh
uid=root
mode=restart
